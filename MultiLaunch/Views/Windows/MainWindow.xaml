<ui:FluentWindow
    x:Class="MultiLaunch.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MultiLaunch.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:b="clr-namespace:MultiLaunch.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--#region Application View -->
        <Grid x:Name="RootMainGrid" Grid.Row="1" Visibility="{Binding ViewModel.RootGridVisibility, FallbackValue=Collasped}" >
            <ui:NavigationView
                x:Name="RootNavigation"
                Padding="42,0,42,0"
                BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
                FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
                FrameMargin="0"
                IsBackButtonVisible="Visible"
                IsPaneToggleVisible="True"
                MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
                PaneDisplayMode="LeftFluent">
                            <!--<ui:NavigationView.Header>
                    <ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />
                </ui:NavigationView.Header>-->
                            <ui:NavigationView.ContentOverlay>
                                <Grid>
                                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                                </Grid>
                            </ui:NavigationView.ContentOverlay>
                        </ui:NavigationView>

            <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />
        </Grid>
        
        <!--#endregion-->
        
        <!--#region Unlock View -->
        <Grid x:Name="SplashGrid" Grid.Row="1" Visibility="{Binding ViewModel.SplashGridVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <Image
                    Width="500"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="pack://application:,,,/Assets/wpfui-icon-1024.png" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                
                <StackPanel x:Name="LoaderStack" Visibility="{Binding ViewModel.LoaderStackVisibility}" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <ui:TextBlock Text="Loading" />
                </StackPanel>
                

                <Grid Margin="0,0,50,0" x:Name="UnlockGrid" Visibility="{Binding ViewModel.UnlockGridVisibility, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:PasswordBox Grid.Row="0" Grid.Column="0" MinWidth="400" PlaceholderText="Enter your main password to unlock the application.">
                        <i:Interaction.Behaviors>
                            <b:PasswordBoxValueBehavior BoundPassword="{Binding ViewModel.UnlockMainPassword}" />
                        </i:Interaction.Behaviors>
                    </ui:PasswordBox>
                    <ui:Button Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Content="Unlock" Command="{Binding ViewModel.UnlockDatabaseCommand}" />

                    <ui:TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,8" Text="{Binding ViewModel.UnlockErrorText}" />
                </Grid>

                <Grid Margin="0,0,50,0" x:Name="FirstRunGrid" Visibility="{Binding ViewModel.FirstRunGridVisibility, FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,16,0,8" Text="Define the main password" />

                    <ui:PasswordBox Grid.Row="1" Grid.Column="0" MinWidth="400" PlaceholderText="Main password...">
                        <i:Interaction.Behaviors>
                            <b:PasswordBoxValueBehavior BoundPassword="{Binding ViewModel.MainPassword}" />
                        </i:Interaction.Behaviors>
                    </ui:PasswordBox>
                    <ui:Button Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Content="Create" Command="{Binding ViewModel.DefineMainPasswordCommand}"/>
                </Grid>
                
            </StackPanel>
        </Grid>
        <!--#endregion-->        
    </Grid>
</ui:FluentWindow>
