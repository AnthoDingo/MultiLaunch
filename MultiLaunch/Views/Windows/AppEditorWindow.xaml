<ui:FluentWindow
    x:Class="MultiLaunch.Views.Windows.AppEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MultiLaunch.Views.Windows"
    xmlns:b="clr-namespace:MultiLaunch.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.WindowTitle, Mode=OneWay}"
    Width="600"
    Height="380"
    d:DataContext="{d:DesignInstance local:AppEditorWindow,
                                     IsDesignTimeCreatable=True}"
    
    d:DesignWidth="600"
    d:DesignHeight="400"   
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"   
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.WindowTitle}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="8,0,16,0" VerticalAlignment="Top">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Apps24" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Application" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                    <ui:TextBox 
                        Grid.Row="0" Grid.Column="1" 
                        Margin="8,0,0,0" 
                        Text="{Binding ViewModel.Application.Name, Mode=TwoWay}" />

                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"  Text="Path" VerticalAlignment="Center" />
                    <ui:TextBox 
                        Grid.Row="1" Grid.Column="1" 
                        Margin="8,8,0,0" 
                        Text="{Binding ViewModel.Application.Path, Mode=TwoWay}" />
                    <ui:Button 
                        Grid.Row="1" Grid.Column="2" 
                        Margin="8,8,0,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="Search"  
                        Command="{Binding ViewModel.BrowseForExecutableCommand}"/>

                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Arguments" VerticalAlignment="Center" />
                    <ui:TextBox 
                        Grid.Row="2" Grid.Column="1" 
                        Margin="8,8,0,0" 
                        Text="{Binding ViewModel.Application.Arguments, Mode=TwoWay}" />

                    <ui:TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0"  Text="Working Directory" VerticalAlignment="Center" />
                    <ui:TextBox 
                        Grid.Row="3" Grid.Column="1"  
                        Margin="8,8,0,0" 
                        Text="{Binding ViewModel.Application.WorkingDirectory, Mode=TwoWay}" />
                    <ui:Button 
                        Grid.Row="3" Grid.Column="2" 
                        Margin="8,8,0,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="Browse"  
                        Command="{Binding ViewModel.BrowseForDirectoryCommand}"/>

                    <ui:TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0"  Text="Run As Admin" VerticalAlignment="Center" />
                    <CheckBox 
                        Grid.Row="4" Grid.Column="1" 
                        Margin="8,8,0,0" 
                        IsChecked="{Binding ViewModel.Application.RunAsAdmin, Mode=TwoWay}" />

                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="InprivateAccount24" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Credential" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,0"  Text="Credential" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding ViewModel.CredentialTypes}" SelectedItem="{Binding ViewModel.SelectedCredentialType, Mode=TwoWay}" />

                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"  Text="Username" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1"  Margin="8,8,0,0" Text="{Binding ViewModel.Application.Credential.Username}" IsEnabled="{Binding ViewModel.IsEnable}"/>

                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"  Text="Password" VerticalAlignment="Center" />
                    <ui:PasswordBox Grid.Row="2" Grid.Column="1" Margin="8,8,0,0" IsEnabled="{Binding ViewModel.IsEnable}">
                        <i:Interaction.Behaviors>
                            <b:PasswordBoxValueBehavior BoundPassword="{Binding ViewModel.Application.Credential.Password}" />
                        </i:Interaction.Behaviors>
                    </ui:PasswordBox>

                    <ui:TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0"  Text="Domain" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="3" Grid.Column="1"  Margin="8,8,0,0" Text="{Binding ViewModel.Application.Credential.Domain}" IsEnabled="{Binding ViewModel.IsEnable}" />
                </Grid>

            </TabItem>

        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,16,16">
            <ui:Button 
                Margin="8,8,8,8" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Content="Cancel" 
                Appearance="Danger"
                Command="{Binding ViewModel.CancelCommand}"/>
            <!--<ui:Button 
                Margin="8,8,8,8" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Content="Delete" 
                Command="{Binding ViewModel.DeleteCommand}"
                IsEnabled="{Binding ViewModel.IsEnable}"/>-->
            <ui:Button 
                Margin="8,8,8,8" 
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Content="Save" 
                Appearance="Success"
                Command="{Binding ViewModel.SaveCommand}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
